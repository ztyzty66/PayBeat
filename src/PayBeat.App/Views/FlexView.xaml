<UserControl x:Class="PayBeat.App.Views.FlexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Flex fullscreen dashboard: today panel (left) + month panel (right) + stats row. -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush x:Name="BackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="BackgroundStopStart" Color="{DynamicResource AccentGradientFromColor}" Offset="0"/>
                <GradientStop x:Name="BackgroundStopMiddle" Color="{DynamicResource FlexGradientMidColor}" Offset="0.5"/>
                <GradientStop x:Name="BackgroundStopEnd" Color="{DynamicResource BaseColor}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Glow behind the amount -->
        <Ellipse x:Name="GlowEllipse" Width="900" Height="500" Fill="{DynamicResource GreenBrush}" Opacity="0.07"
                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-100,0,0,0">
            <Ellipse.Effect>
                <BlurEffect Radius="160"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Top-right actions -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,24,32,0">
            <Button Command="{Binding OpenSettingsCommand}"
                    FontFamily="Segoe MDL2 Assets" FontSize="16"
                    Content="&#xE713;"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource SubtextBrush}"
                    Padding="12,8"/>
            <Button Command="{Binding SetNoneModeCommand}"
                    FontFamily="Segoe MDL2 Assets" FontSize="16"
                    Content="&#xE711;"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource SubtextBrush}"
                    Padding="12,8" Margin="10,0,0,0"/>
        </StackPanel>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="1040">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Today panel ── -->
            <StackPanel Grid.Column="0" Margin="0,0,48,0">
                <TextBlock Text="{DynamicResource View.EarnedToday}"
                           Foreground="{DynamicResource SubtextBrush}"
                           FontFamily="Segoe UI" FontSize="20"/>
                <!-- Work day: show earnings -->
                <StackPanel Visibility="{Binding IsRestDay, Converter={StaticResource InvertedBoolToCollapsedConverter}, FallbackValue=Visible}">
                    <TextBlock Text="{Binding EarnedFormatted, Mode=OneWay}"
                               Foreground="{DynamicResource GreenBrush}"
                               FontFamily="Segoe UI" FontSize="88" FontWeight="Bold"
                               Margin="0,4,0,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="AmountScale"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource GreenColor}" Opacity="0.5" BlurRadius="36" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding TargetTodayFormatted, Mode=OneWay, StringFormat=/{0}}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontFamily="Segoe UI" FontSize="22"
                               Margin="4,0,0,12"/>
                </StackPanel>
                <!-- Rest day: show message -->
                <StackPanel Visibility="{Binding IsRestDay, Converter={StaticResource BoolToCollapsedConverter}, FallbackValue=Collapsed}">
                    <TextBlock Text="😴 今天休息"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="Segoe UI" FontSize="48" FontWeight="SemiBold"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding RestDayMessage, Mode=OneWay}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontFamily="Segoe UI" FontSize="20"
                               Margin="4,4,0,12"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                 Minimum="0" Maximum="1" Height="12"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource GreenBrush}"
                                 BorderThickness="0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressText, Mode=OneWay}"
                               Foreground="{DynamicResource GreenBrush}"
                               FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold"
                               Margin="12,0,0,0"/>
                </Grid>

                <!-- Today status -->
                <StackPanel Orientation="Horizontal" Margin="2,14,0,0">
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                               Foreground="{DynamicResource GreenBrush}"
                               FontFamily="Segoe UI, Segoe UI Emoji, Segoe UI Symbol" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusDetail, Mode=OneWay}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontFamily="Segoe UI" FontSize="16" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- ── Month panel ── -->
            <StackPanel Grid.Column="1" Margin="48,0,0,0">
                <TextBlock Text="{DynamicResource View.MonthProgress}"
                           Foreground="{DynamicResource SubtextBrush}"
                           FontFamily="Segoe UI" FontSize="20"/>
                <TextBlock Text="{Binding MonthEarnedFormatted, Mode=OneWay}"
                           Foreground="{DynamicResource TextBrush}"
                           FontFamily="Segoe UI" FontSize="60" FontWeight="Bold"
                           Margin="0,4,0,0"/>
                <TextBlock Text="{Binding StandardMonthlyFormatted, Mode=OneWay, StringFormat=/{0}}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontFamily="Segoe UI" FontSize="22"
                           Margin="4,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Value="{Binding MonthProgress, Mode=OneWay}"
                                 Minimum="0" Maximum="1" Height="12"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource BlueBrush}"
                                 BorderThickness="0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding MonthProgressText, Mode=OneWay}"
                               Foreground="{DynamicResource BlueBrush}"
                               FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold"
                               Margin="12,0,0,0"/>
                </Grid>

                <!-- Expected + standard monthly -->
                <Grid Margin="2,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="17"
                                Background="{DynamicResource TagPtoBrush}">
                            <TextBlock Text="&#xE817;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{DynamicResource OrangeBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="{DynamicResource View.MonthExpected}"
                                       Foreground="{DynamicResource MutedBrush}" FontFamily="Segoe UI" FontSize="13"/>
                            <TextBlock Text="{Binding MonthTargetFormatted, Mode=OneWay}"
                                       Foreground="{DynamicResource OrangeBrush}"
                                       FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="17"
                                Background="{DynamicResource TagMakeupBrush}">
                            <TextBlock Text="&#xE816;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{DynamicResource BlueBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="{DynamicResource View.StandardMonthly}"
                                       Foreground="{DynamicResource MutedBrush}" FontFamily="Segoe UI" FontSize="13"/>
                            <TextBlock Text="{Binding StandardMonthlyFormatted, Mode=OneWay}"
                                       Foreground="{DynamicResource BlueBrush}"
                                       FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Bottom stats row -->
        <UniformGrid Columns="4" Width="1040"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom"
                     Margin="0,0,0,64">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x23F1;" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="20"
                           Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center"/>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="{DynamicResource View.Worked}"
                               Foreground="{DynamicResource MutedBrush}" FontFamily="Segoe UI" FontSize="14"/>
                    <TextBlock Text="{Binding ElapsedFormattedShort, Mode=OneWay}"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="Segoe UI" FontSize="26" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x23F3;" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="20"
                           Foreground="{DynamicResource PurpleBrush}" VerticalAlignment="Center"/>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="{DynamicResource View.UntilEnd}"
                               Foreground="{DynamicResource MutedBrush}" FontFamily="Segoe UI" FontSize="14"/>
                    <TextBlock Text="{Binding RemainingFormattedShort, Mode=OneWay}"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="Segoe UI" FontSize="26" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💰" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="18"
                           Foreground="{DynamicResource AmberBrush}" VerticalAlignment="Center"/>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="{DynamicResource View.MonthEarned}"
                               Foreground="{DynamicResource MutedBrush}" FontFamily="Segoe UI" FontSize="14"/>
                    <TextBlock Text="{Binding MonthEarnedFormatted, Mode=OneWay}"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="Segoe UI" FontSize="26" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📅" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="18"
                           Foreground="{DynamicResource BlueBrush}" VerticalAlignment="Center"/>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="{DynamicResource View.WorkdaysProgress}"
                               Foreground="{DynamicResource MutedBrush}" FontFamily="Segoe UI" FontSize="14"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding WorkdaysText, Mode=OneWay}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontFamily="Segoe UI" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource View.Days}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Segoe UI" FontSize="14" Margin="6,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </UniformGrid>
    </Grid>
</UserControl>
