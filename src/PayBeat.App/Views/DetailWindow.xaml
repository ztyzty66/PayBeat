<Window x:Class="PayBeat.App.Views.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Detail.Title}"
        Width="520"
        Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="HistoryListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="8" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TagWorkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GreenBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MiniCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,9"/>
        </Style>
        <Style x:Key="MiniCardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="MiniCardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BaseBrush}"
            CornerRadius="14"
            BorderBrush="{DynamicResource OverlayBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="26" ShadowDepth="0"/>
        </Border.Effect>

        <DockPanel Margin="24,18">

            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Detail.Title}" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="Bold"/>
                </StackPanel>
                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        HorizontalAlignment="Right" Click="OnClose"
                        Background="Transparent" Foreground="{DynamicResource SubtextBrush}" Padding="6,3"/>
            </Grid>

            <!-- Tabs -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton Content="{DynamicResource Detail.Tab.Today}" Style="{StaticResource DetailTab}"
                             GroupName="tabs" IsChecked="True" Checked="OnTodayTab"/>
                <RadioButton Content="{DynamicResource Detail.Tab.Month}" Style="{StaticResource DetailTab}"
                             GroupName="tabs" Checked="OnMonthTab"/>
            </StackPanel>

            <!-- ── TODAY tab ── -->
            <ScrollViewer x:Name="TodayView" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Hero card -->
                    <Border CornerRadius="14" Padding="22,18" Margin="0,0,0,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource GreenColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentGradientFromColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: amount block (left) + worked/remaining (right) -->
                            <Grid Grid.Row="0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource View.EarnedToday}"
                                               Foreground="#C8FFFFFF" FontSize="12"/>
                                    <TextBlock Text="{Binding EarnedFormatted, Mode=OneWay}"
                                               Foreground="White" FontSize="40" FontWeight="Bold" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding TargetTodayFormatted, Mode=OneWay, StringFormat=/{0}}"
                                               Foreground="#B8FFFFFF" FontSize="14" Margin="2,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,2,4">
                                    <TextBlock Text="&#xE817;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                    <StackPanel Margin="8,0,18,0">
                                        <TextBlock Text="{DynamicResource View.Worked}" Foreground="#B8FFFFFF" FontSize="11"/>
                                        <TextBlock Text="{Binding ElapsedFormattedShort, Mode=OneWay}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="&#xE816;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{DynamicResource View.UntilEnd}" Foreground="#B8FFFFFF" FontSize="11"/>
                                        <TextBlock Text="{Binding RemainingFormattedShort, Mode=OneWay}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: progress -->
                            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="1"
                                             Height="7" BorderThickness="0"
                                             Background="#40FFFFFF" Foreground="White"/>
                                <TextBlock Text="{Binding ProgressText, Mode=OneWay}"
                                           Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Month overview -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Detail.MonthOverview}"
                                   Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource Detail.CurrentSchedule}"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding ScheduleName, Mode=OneWay, StringFormat=· {0}}"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource MiniCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource View.MonthEarned}" Style="{StaticResource MiniCardLabel}"/>
                                <TextBlock Text="{Binding MonthEarnedFormatted, Mode=OneWay}" Style="{StaticResource MiniCardValue}" Foreground="{DynamicResource GreenBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource MiniCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource View.MonthExpected}" Style="{StaticResource MiniCardLabel}"/>
                                <TextBlock Text="{Binding MonthTargetFormatted, Mode=OneWay}" Style="{StaticResource MiniCardValue}" Foreground="{DynamicResource OrangeBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource MiniCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource View.StandardMonthly}" Style="{StaticResource MiniCardLabel}"/>
                                <TextBlock Text="{Binding StandardMonthlyFormatted, Mode=OneWay}" Style="{StaticResource MiniCardValue}" Foreground="{DynamicResource BlueBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Value="{Binding MonthProgress, Mode=OneWay}" Minimum="0" Maximum="1"
                                     Height="7" BorderThickness="0"
                                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource GreenBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding MonthProgressText, Mode=OneWay}"
                                   Foreground="{DynamicResource GreenBrush}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Workday / leave / PTO cards -->
                    <Grid Margin="0,12,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource MiniCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource View.WorkdaysProgress}" Style="{StaticResource MiniCardLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding WorkdaysText, Mode=OneWay}" Style="{StaticResource MiniCardValue}" Foreground="{DynamicResource GreenBrush}"/>
                                    <TextBlock Text="{DynamicResource View.Days}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="5,9,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource MiniCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource View.LeaveHours}" Style="{StaticResource MiniCardLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LeaveHoursText, Mode=OneWay}" Style="{StaticResource MiniCardValue}" Foreground="{DynamicResource RedBrush}"/>
                                    <TextBlock Text="{DynamicResource View.Hours}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="5,9,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource MiniCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource View.PtoDays}" Style="{StaticResource MiniCardLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PtoDaysText, Mode=OneWay}" Style="{StaticResource MiniCardValue}" Foreground="{DynamicResource OrangeBrush}"/>
                                    <TextBlock Text="{DynamicResource View.Days}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="5,9,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Current schedule -->
                    <Border Style="{StaticResource MiniCard}" Padding="14,11">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE817;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource BlueBrush}" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="{DynamicResource Detail.CurrentSchedule}" Style="{StaticResource MiniCardLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding ScheduleName, Mode=OneWay}" FontSize="12"
                                               Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding WorkWindowText, Mode=OneWay, StringFormat=  ·  {0}}" FontSize="12"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding LunchWindowText, Mode=OneWay, StringFormat=  ({0})}"
                                               FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                               Visibility="{Binding HasLunch, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ── MONTH tab ── -->
            <Grid x:Name="MonthView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ItemsControl x:Name="MonthList" Grid.Column="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="OnMonthClick" Cursor="Hand" HorizontalAlignment="Stretch"
                                    Margin="0,0,6,6" Padding="10,8"
                                    Background="{DynamicResource SurfaceBrush}"
                                    Foreground="{DynamicResource TextBrush}" FontSize="12"
                                    Content="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="HistoryEmpty" Text="{DynamicResource Detail.NoHistory}"
                               Foreground="{DynamicResource MutedBrush}" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,40,0,0"/>
                    <StackPanel x:Name="HistoryDetail" Visibility="Collapsed">
                        <StackPanel.Resources>
                            <Style x:Key="RowLabel" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                            </Style>
                            <Style x:Key="RowValue" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Margin" Value="0,2,0,0"/>
                            </Style>
                        </StackPanel.Resources>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource MiniCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Detail.StandardSalary}" Style="{StaticResource RowLabel}"/>
                                    <TextBlock x:Name="HistStandard" Style="{StaticResource RowValue}" Foreground="{DynamicResource BlueBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource MiniCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource View.MonthExpected}" Style="{StaticResource RowLabel}"/>
                                    <TextBlock x:Name="HistTarget" Style="{StaticResource RowValue}" Foreground="{DynamicResource OrangeBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource MiniCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Detail.FinalEarned}" Style="{StaticResource RowLabel}"/>
                                    <TextBlock x:Name="HistEarned" Style="{StaticResource RowValue}" Foreground="{DynamicResource GreenBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource MiniCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Detail.Workdays}" Style="{StaticResource RowLabel}"/>
                                    <TextBlock x:Name="HistWorkdays" Style="{StaticResource RowValue}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource MiniCard}" Padding="14,11" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Detail.ScheduleUsed}" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="HistSchedule" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,2,0,0"/>
                                <TextBlock Text="{DynamicResource Detail.PolicyUsed}" Style="{StaticResource RowLabel}" Margin="0,8,0,0"/>
                                <TextBlock x:Name="HistPolicy" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource Detail.SpecialDays}" Style="{StaticResource RowLabel}" Margin="0,2,0,6"/>
                        <ItemsControl x:Name="SpecialDaysList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                                            Padding="8,4" Margin="0,0,6,6" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
