<Application x:Class="PayBeat.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:PayBeat.App.Helpers"
             ShutdownMode="OnExplicitShutdown">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:BoolToCollapsedConverter x:Key="BoolToCollapsedConverter"/>
            <helpers:InvertedBoolToCollapsedConverter x:Key="InvertedBoolToCollapsedConverter"/>
            <helpers:StringNotEmptyToVisibleConverter x:Key="StringNotEmptyToVisibleConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
