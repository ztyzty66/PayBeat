<UserControl x:Class="PayBeat.App.Views.MiniView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mini pill: brand dot + amount, quick settings/close on hover. -->
    <Border CornerRadius="18"
            BorderThickness="1"
            BorderBrush="{DynamicResource OverlayBrush}"
            Background="{DynamicResource BaseBrush}"
            Padding="12,8,8,8"
            Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="18" ShadowDepth="0"/>
        </Border.Effect>
        <Border.ToolTip>
            <ToolTip>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ProgressText, Mode=OneWay}"
                               Foreground="{DynamicResource GreenBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="  ·  " Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding RemainingFormattedShort, Mode=OneWay, StringFormat=距下班 {0}}"
                               Foreground="{DynamicResource SubtextBrush}"/>
                </StackPanel>
            </ToolTip>
        </Border.ToolTip>

        <StackPanel Orientation="Horizontal">

            <!-- Currency badge -->
            <Border Width="26" Height="26" CornerRadius="13"
                    Background="{DynamicResource TagWorkBrush}" VerticalAlignment="Center">
                <TextBlock Text="{Binding Currency, Mode=OneWay}"
                           Foreground="{DynamicResource GreenBrush}"
                           FontSize="13" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Amount -->
            <TextBlock Text="{Binding EarnedFormatted, Mode=OneWay}"
                       Foreground="{DynamicResource TextBrush}"
                       FontFamily="Segoe UI"
                       FontSize="17"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="8,0,8,0"/>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.75">
                <Button Command="{Binding OpenSettingsCommand}"
                        FontFamily="Segoe MDL2 Assets" FontSize="11"
                        Content="&#xE713;"
                        Background="Transparent"
                        Foreground="{DynamicResource SubtextBrush}"
                        Padding="6,4" Margin="0,0,2,0"/>
                <Button Command="{Binding SetNoneModeCommand}"
                        FontFamily="Segoe MDL2 Assets" FontSize="11"
                        Content="&#xE711;"
                        Background="Transparent"
                        Foreground="{DynamicResource SubtextBrush}"
                        Padding="6,4"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
