<UserControl x:Class="PayBeat.App.Views.NormalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Normal card: clean neutral surface, a whisper of cool light top-left, green as the
         single accent. Amount is the visual anchor; everything else stays quiet. -->
    <Border CornerRadius="16"
            BorderThickness="1"
            BorderBrush="{DynamicResource OverlayBrush}"
            Width="340"
            Background="{DynamicResource WidgetCardBrush}"
            Padding="22,18,22,18">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.28" BlurRadius="18" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <!-- Very light cool highlight, top-left only (no full-surface gradient) -->
            <Border CornerRadius="16" IsHitTestVisible="False" Opacity="0.55">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,0.55">
                        <GradientStop Color="{DynamicResource WidgetHighlightColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource WidgetCardColor}" Offset="0.55"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel>

                <!-- Header: label + actions -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource View.EarnedToday}"
                               Foreground="{DynamicResource SubtextBrush}"
                               FontFamily="Segoe UI" FontSize="12"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding OpenSettingsCommand}"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" FontSize="12"
                                Content="&#xE713;"
                                Background="Transparent"
                                Foreground="{DynamicResource SubtextBrush}"
                                Padding="6,3"/>
                        <Button Command="{Binding SetNoneModeCommand}"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" FontSize="12"
                                Content="&#xE711;"
                                Background="Transparent"
                                Foreground="{DynamicResource SubtextBrush}"
                                Padding="6,3" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Amount (work days): the single strong element -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                            Visibility="{Binding IsRestDay, Converter={StaticResource InvertedBoolToCollapsedConverter}, FallbackValue=Visible}">
                    <TextBlock Text="{Binding EarnedFormatted, Mode=OneWay}"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="Segoe UI" FontSize="36" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                            Visibility="{Binding IsRestDay, Converter={StaticResource InvertedBoolToCollapsedConverter}, FallbackValue=Visible}">
                    <TextBlock Text="{DynamicResource View.TodayTarget}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontFamily="Segoe UI" FontSize="12"/>
                    <TextBlock Text="{Binding TargetTodayFormatted, Mode=OneWay, StringFormat=' {0}'}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontFamily="Segoe UI" FontSize="12"/>
                </StackPanel>

                <!-- Rest day: calm, informative, no fake zeros -->
                <StackPanel Margin="0,8,0,2"
                            Visibility="{Binding IsRestDay, Converter={StaticResource BoolToCollapsedConverter}, FallbackValue=Collapsed}">
                    <TextBlock Text="{DynamicResource View.RestTitle}"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="Segoe UI" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding RestDayMessage, Mode=OneWay}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontFamily="Segoe UI" FontSize="12.5" Margin="1,4,0,0"/>
                </StackPanel>

                <!-- Status line -->
                <StackPanel Orientation="Horizontal" Margin="1,6,0,0">
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                               Foreground="{DynamicResource GreenBrush}"
                               FontFamily="Segoe UI, Segoe UI Emoji, Segoe UI Symbol" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusDetail, Mode=OneWay}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontFamily="Segoe UI" FontSize="12" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Thin progress -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                 Minimum="0" Maximum="1"
                                 Height="4"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource GreenBrush}"
                                 BorderThickness="0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressText, Mode=OneWay}"
                               Foreground="{DynamicResource GreenBrush}"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                               Margin="8,0,0,0"/>
                </Grid>

                <!-- Bottom metrics: strictly symmetric -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x23F1;"
                                   FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="13"
                                   Foreground="{DynamicResource GreenBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource View.Worked}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontFamily="Segoe UI" FontSize="11"/>
                            <TextBlock Text="{Binding ElapsedFormattedShort, Mode=OneWay}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="&#x23F3;"
                                   FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource View.UntilEnd}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontFamily="Segoe UI" FontSize="11"/>
                            <TextBlock Text="{Binding RemainingFormattedShort, Mode=OneWay}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
