<Window x:Class="PayBeat.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PayBeat.App.Views.Controls"
        xmlns:views="clr-namespace:PayBeat.App.Views"
        Title="{DynamicResource Settings.WindowTitle}"
        Width="680"
        Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>

        <!-- Vertical nav tab item -->
        <Style x:Key="NavTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="Transparent"
                                Padding="14,11"
                                Margin="8,2"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Icon"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                           FontSize="14"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Header}"
                                           FontSize="13"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource TagWorkBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource GreenBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Field label inside a card -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Segmented button style (mode / week presets) -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg"
                                Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="8"
                                Padding="18,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GreenBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BaseBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Day-of-week toggle chip -->
        <Style x:Key="DayChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg"
                                Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="7"
                                Padding="0,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TagWorkBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bubble popup shown next to a TextBox when its bound value fails validation -->
        <ControlTemplate x:Key="ValidationBubbleTemplate">
            <StackPanel>
                <AdornedElementPlaceholder x:Name="Placeholder" />
                <Popup IsOpen="True"
                       PlacementTarget="{Binding ElementName=Placeholder}"
                       Placement="Top"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource RedBrush}"
                            CornerRadius="6"
                            Padding="8,5"
                            Margin="0,0,0,4">
                        <TextBlock Text="{Binding ElementName=Placeholder, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"
                                   Foreground="{DynamicResource BaseBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MaxWidth="240" />
                    </Border>
                </Popup>
            </StackPanel>
        </ControlTemplate>

        <!-- TextBox style applying the validation bubble and a red border while invalid -->
        <Style x:Key="ValidatedTextBox" TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ValidationBubbleTemplate}" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource RedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BaseBrush}"
            CornerRadius="14"
            BorderBrush="{DynamicResource OverlayBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="24" ShadowDepth="0" />
        </Border.Effect>

        <DockPanel Margin="24,20" LastChildFill="True">

            <!-- Title -->
            <TextBlock DockPanel.Dock="Top"
                   Text="{DynamicResource Settings.Title}"
                   Foreground="{DynamicResource TextBrush}"
                   FontSize="19"
                   FontWeight="Bold"
                   Margin="0,0,0,14" />

            <!-- Error -->
            <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource RedBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   MinHeight="16" />

            <!-- Buttons -->
            <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
                <Button Content="{DynamicResource Settings.Cancel}"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0" />
                <Button Content="{DynamicResource Settings.Save}"
                    Command="{Binding SaveCommand}"
                    Background="{DynamicResource GreenBrush}"
                    Foreground="{DynamicResource BaseBrush}"
                    FontWeight="SemiBold" />
            </StackPanel>

            <!-- Vertical nav + pages -->
            <TabControl Background="Transparent"
                    BorderThickness="0"
                    TabStripPlacement="Left">

                <!-- ── Salary ── -->
                <TabItem Header="{DynamicResource Settings.Tab.Salary}" Tag="&#xE7E9;" Style="{StaticResource NavTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,4,0,4">
                        <StackPanel>

                            <!-- Card A: salary -->
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.Card.Pay}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{DynamicResource Settings.Mode}" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton Content="{DynamicResource Settings.Mode.Monthly}" Style="{StaticResource SegmentButton}"
                                                     IsChecked="{Binding IsMonthlyMode, Mode=TwoWay}"/>
                                        <RadioButton Content="{DynamicResource Settings.Mode.Daily}" Style="{StaticResource SegmentButton}"
                                                     IsChecked="{Binding IsDailyMode, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <TextBlock Text="{DynamicResource Settings.Amount}" Style="{StaticResource FieldLabel}"/>
                                    <Grid MaxWidth="280" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                             Text="¥"
                                             IsReadOnly="True"
                                             Background="{DynamicResource SurfaceBrush}"
                                             Foreground="{DynamicResource MutedBrush}"
                                             BorderBrush="{DynamicResource OverlayBrush}"
                                             BorderThickness="1"
                                             Padding="10,8" />
                                        <TextBox Grid.Column="2"
                                             Style="{StaticResource ValidatedTextBox}"
                                             Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                             TextAlignment="Right"
                                             Background="{DynamicResource SurfaceBrush}"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource OverlayBrush}"
                                             BorderThickness="1"
                                             Padding="10,8"
                                             MaxLength="11"
                                             PreviewTextInput="Salary_PreviewTextInput"
                                             DataObject.Pasting="Salary_Pasting" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card B: work policy -->
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.Card.Work}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{DynamicResource Settings.WeekPolicy}" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton Content="{DynamicResource Settings.Week.Double}" Style="{StaticResource SegmentButton}"
                                                     IsChecked="{Binding IsDoubleRest, Mode=TwoWay}"/>
                                        <RadioButton Content="{DynamicResource Settings.Week.Single}" Style="{StaticResource SegmentButton}"
                                                     IsChecked="{Binding IsSingleRest, Mode=TwoWay}"/>
                                        <RadioButton Content="{DynamicResource Settings.Week.Custom}" Style="{StaticResource SegmentButton}"
                                                     IsChecked="{Binding IsCustomWeek, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <TextBlock Text="{DynamicResource Settings.RestDays}" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Content="{DynamicResource Day.Mon}" Style="{StaticResource DayChip}" IsChecked="{Binding WorkMonday, Mode=TwoWay}"/>
                                        <ToggleButton Content="{DynamicResource Day.Tue}" Style="{StaticResource DayChip}" IsChecked="{Binding WorkTuesday, Mode=TwoWay}"/>
                                        <ToggleButton Content="{DynamicResource Day.Wed}" Style="{StaticResource DayChip}" IsChecked="{Binding WorkWednesday, Mode=TwoWay}"/>
                                        <ToggleButton Content="{DynamicResource Day.Thu}" Style="{StaticResource DayChip}" IsChecked="{Binding WorkThursday, Mode=TwoWay}"/>
                                        <ToggleButton Content="{DynamicResource Day.Fri}" Style="{StaticResource DayChip}" IsChecked="{Binding WorkFriday, Mode=TwoWay}"/>
                                        <ToggleButton Content="{DynamicResource Day.Sat}" Style="{StaticResource DayChip}" IsChecked="{Binding WorkSaturday, Mode=TwoWay}"/>
                                        <ToggleButton Content="{DynamicResource Day.Sun}" Style="{StaticResource DayChip}" IsChecked="{Binding WorkSunday, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card C: schedule -->
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="{DynamicResource Settings.Card.Schedule}" Style="{StaticResource CardTitle}" Margin="0"/>
                                        <Button Command="{Binding ManageSchedulesCommand}"
                                            Content="{DynamicResource Settings.ManageSchedules}"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right"
                                            FontSize="12"/>
                                    </Grid>

                                    <TextBlock Text="{Binding CurrentScheduleName, Mode=OneWay}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                       Text="{DynamicResource Settings.WorkHours}"
                                       Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Margin="0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:TimePickerControl SelectedTime="{Binding WorkStart}" />
                                            <TextBlock Text="–" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="6,0" />
                                            <controls:TimePickerControl SelectedTime="{Binding WorkEnd}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                      Content="{DynamicResource Settings.LunchBreakEnabled}"
                                      IsChecked="{Binding LunchBreakEnabled}"
                                      Foreground="{DynamicResource TextBrush}"
                                      FontSize="13"
                                      Cursor="Hand"
                                      VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding LunchBreakEnabled}">
                                            <controls:TimePickerControl SelectedTime="{Binding LunchBreakStart}" />
                                            <TextBlock Text="–" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="6,0" />
                                            <controls:TimePickerControl SelectedTime="{Binding LunchBreakEnd}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card D: note -->
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.Card.Info}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{DynamicResource Settings.Info.Text}"
                                   Foreground="{DynamicResource SubtextBrush}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ── Calendar ── -->
                <TabItem Header="{DynamicResource Settings.Tab.Calendar}" Tag="&#xE787;" Style="{StaticResource NavTabItem}">
                    <views:CalendarPageControl x:Name="CalendarPage" Margin="8,0,0,0"/>
                </TabItem>

                <!-- ── Display ── -->
                <TabItem Header="{DynamicResource Settings.Tab.Display}" Tag="&#xE7F4;" Style="{StaticResource NavTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,4,0,4">
                        <StackPanel>

                            <!-- Card A: widget -->
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Display.Card.Widget}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{DynamicResource Settings.DisplayMode}" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <RadioButton Content="{DynamicResource Settings.Flex}" Style="{StaticResource SegmentButton}"
                                                 IsChecked="{Binding IsFlexMode, Mode=TwoWay}"/>
                                        <RadioButton Content="{DynamicResource Settings.Normal}" Style="{StaticResource SegmentButton}"
                                                 IsChecked="{Binding IsNormalMode, Mode=TwoWay}"/>
                                        <RadioButton Content="{DynamicResource Settings.Mini}" Style="{StaticResource SegmentButton}"
                                                 IsChecked="{Binding IsMiniMode, Mode=TwoWay}"/>
                                        <RadioButton Content="{DynamicResource Settings.None}" Style="{StaticResource SegmentButton}"
                                                 IsChecked="{Binding IsNoneMode, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Settings.Opacity}"
                                   Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0"/>
                                        <TextBlock Grid.Column="1"
                                   Text="{Binding Opacity, StringFormat={}{0:P0}}"
                                   Foreground="{DynamicResource GreenBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider Minimum="0.1"
                                        Maximum="1.0"
                                        Value="{Binding Opacity}"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        Foreground="{DynamicResource BlueBrush}"
                                        Margin="0,0,0,14" />

                                    <CheckBox Content="{DynamicResource Settings.AlwaysOnTop}"
                                      IsChecked="{Binding AlwaysOnTop}"
                                      Foreground="{DynamicResource TextBrush}"
                                      FontSize="13"
                                      Cursor="Hand" />
                                </StackPanel>
                            </Border>

                            <!-- Card B: appearance -->
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Display.Card.Appearance}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{DynamicResource Settings.Theme}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding AvailableThemes}"
                                      SelectedValue="{Binding Theme}"
                                      SelectedValuePath="Code"
                                      MaxWidth="240"
                                      HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding Name}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Code}" Value="auto">
                                                                    <Setter Property="Text" Value="{DynamicResource Settings.ThemeAuto}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Code}" Value="light">
                                                                    <Setter Property="Text" Value="{DynamicResource Settings.ThemeLight}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Code}" Value="dark">
                                                                    <Setter Property="Text" Value="{DynamicResource Settings.ThemeDark}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- Card C: refresh -->
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Display.Card.Refresh}" Style="{StaticResource CardTitle}" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Settings.RefreshInterval}"
                                   Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding RefreshInterval}"
                                       Foreground="{DynamicResource GreenBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Settings.Seconds}"
                                       Foreground="{DynamicResource GreenBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <Slider Minimum="1"
                                        Maximum="60"
                                        Value="{Binding RefreshInterval}"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Foreground="{DynamicResource BlueBrush}"
                                        Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Display.RefreshHint}"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                   TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ── System ── -->
                <TabItem Header="{DynamicResource Settings.Tab.System}" Tag="&#xE713;" Style="{StaticResource NavTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,4,0,4">
                        <StackPanel>

                            <!-- Card A: startup & reminders -->
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource System.Card.Startup}" Style="{StaticResource CardTitle}" />
                                    <CheckBox Content="{DynamicResource Settings.RunAtStartup}"
                              IsChecked="{Binding RunAtStartup}"
                              Foreground="{DynamicResource TextBrush}"
                              FontSize="13"
                              Cursor="Hand"
                              Margin="0,0,0,12" />

                                    <CheckBox Content="{DynamicResource Settings.EnableEndOfDayReminder}"
                              IsChecked="{Binding EnableEndOfDayReminder}"
                              Foreground="{DynamicResource TextBrush}"
                              FontSize="13"
                              Cursor="Hand"
                              Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,12" IsEnabled="{Binding EnableEndOfDayReminder}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Settings.EndOfDayReminderMinutes}"
                                   Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0"/>
                                        <TextBox Grid.Column="2"
                                 Style="{StaticResource ValidatedTextBox}"
                                 Text="{Binding EndOfDayReminderMinutesText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                 TextAlignment="Right"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource OverlayBrush}"
                                 BorderThickness="1"
                                 Padding="10,8"
                                 MaxLength="2"
                                 PreviewTextInput="Integer_PreviewTextInput"
                                 DataObject.Pasting="Integer_Pasting" />
                                    </Grid>

                                    <CheckBox Content="{DynamicResource Settings.EnableMilestoneNotifications}"
                              IsChecked="{Binding EnableMilestoneNotifications}"
                              Foreground="{DynamicResource TextBrush}"
                              FontSize="13"
                              Cursor="Hand"
                              Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,2" IsEnabled="{Binding EnableMilestoneNotifications}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Settings.MilestoneAmount}"
                                   Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0"/>
                                        <TextBox Grid.Column="2"
                                 Style="{StaticResource ValidatedTextBox}"
                                 Text="{Binding MilestoneAmountText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                 TextAlignment="Right"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource OverlayBrush}"
                                 BorderThickness="1"
                                 Padding="10,8"
                                 MaxLength="11"
                                 PreviewTextInput="Salary_PreviewTextInput"
                                 DataObject.Pasting="Salary_Pasting" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card B: hotkey -->
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource System.Card.Hotkey}" Style="{StaticResource CardTitle}" />
                                    <TextBox x:Name="HotkeyBox"
                             Text="{Binding HotkeyDisplayText, Mode=OneWay}"
                             IsReadOnly="True"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource OverlayBrush}"
                             BorderThickness="1"
                             Padding="10,8"
                             Cursor="IBeam"
                             MaxWidth="280"
                             HorizontalAlignment="Left"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                             GotFocus="HotkeyBox_GotFocus"
                             LostFocus="HotkeyBox_LostFocus" />
                                    <TextBlock Text="{DynamicResource Settings.HotkeyHint}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11"
                               Margin="0,6,0,6" />
                                    <Border Style="{StaticResource WarningCallout}"
                                x:Name="HotkeyWarningCallout">
                                        <TextBlock Text="{Binding HotkeyStatus, Mode=OneWay}"
                                   Foreground="{DynamicResource RedBrush}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Card C: language -->
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource System.Card.Language}" Style="{StaticResource CardTitle}" />
                                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedValue="{Binding Language}"
                              SelectedValuePath="Code"
                              MaxWidth="240"
                              HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding Name}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Code}" Value="auto">
                                                                    <Setter Property="Text" Value="{DynamicResource Settings.LanguageAuto}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- Card D: about -->
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource System.Card.About}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="今日薪动"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{DynamicResource About.Tagline}"
                                   Foreground="{DynamicResource SubtextBrush}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                                    <TextBlock Text="{DynamicResource Settings.BasedOn}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,6,0,0">
                                        <Hyperlink NavigateUri="https://github.com/coldhighsun/PayBeat"
                                       RequestNavigate="OriginalProject_RequestNavigate"
                                       Foreground="{DynamicResource BlueBrush}">
                                            <Run Text="{DynamicResource Settings.OpenOriginal}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
