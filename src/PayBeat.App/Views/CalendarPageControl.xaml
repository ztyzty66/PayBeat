<UserControl x:Class="PayBeat.App.Views.CalendarPageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:PayBeat.App.Helpers"             Loaded="OnLoaded"
             Unloaded="OnUnloaded">

    <UserControl.Resources>
        <Style x:Key="CalendarHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LegendItem" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="5,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- Month calendar with per-day status tags; click a day to edit. -->
    <StackPanel>

        <!-- Toolbar -->
        <Grid Margin="0,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding MonthTitle, Mode=OneWay}"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                        Click="OnPrevMonth" Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextBrush}" Padding="8,5"/>
                <Button Content="{DynamicResource Calendar.Today}"
                        Click="OnToday" Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextBrush}" Padding="12,5" Margin="6,0"/>
                <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                        Click="OnNextMonth" Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextBrush}" Padding="8,5"/>
            </StackPanel>
        </Grid>

        <!-- Weekday header -->
        <UniformGrid Columns="7" Margin="0,0,0,4">
            <TextBlock Text="{DynamicResource Day.Mon}" Style="{StaticResource CalendarHeader}"/>
            <TextBlock Text="{DynamicResource Day.Tue}" Style="{StaticResource CalendarHeader}"/>
            <TextBlock Text="{DynamicResource Day.Wed}" Style="{StaticResource CalendarHeader}"/>
            <TextBlock Text="{DynamicResource Day.Thu}" Style="{StaticResource CalendarHeader}"/>
            <TextBlock Text="{DynamicResource Day.Fri}" Style="{StaticResource CalendarHeader}"/>
            <TextBlock Text="{DynamicResource Day.Sat}" Style="{StaticResource CalendarHeader}" Foreground="{DynamicResource RedBrush}"/>
            <TextBlock Text="{DynamicResource Day.Sun}" Style="{StaticResource CalendarHeader}" Foreground="{DynamicResource RedBrush}"/>
        </UniformGrid>

        <!-- Day grid -->
        <ItemsControl ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Click="OnDayClick" Cursor="Hand" Background="Transparent" Padding="1" Margin="0"
                            ToolTipService.InitialShowDelay="300">
                        <Grid>
                            <Border x:Name="Cell"
                                    Height="56"
                                    CornerRadius="8"
                                    Padding="2,1"
                                    Margin="1"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    BorderBrush="Transparent">
                                <StackPanel>
                                    <TextBlock Text="{Binding DayNumber}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Left" Margin="5,2,0,0"/>
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource GreenBrush}"
                                             HorizontalAlignment="Left" Margin="7,3,0,0">
                                        <Ellipse.Visibility>
                                            <Binding Path="ShowDot" Mode="OneWay"/>
                                        </Ellipse.Visibility>
                                    </Ellipse>
                                    <Border CornerRadius="4" Padding="3,1" Margin="3,2,3,0"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource TagRestBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowDot}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Tag}" FontSize="9">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="PublicHoliday">
                                                            <Setter Property="Foreground" Value="{DynamicResource AmberBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="MakeupWork">
                                                            <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="PaidTimeOff">
                                                            <Setter Property="Foreground" Value="{DynamicResource OrangeBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Leave">
                                                            <Setter Property="Foreground" Value="{DynamicResource PurpleBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Manual override marker: small pencil in the top-right corner -->
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="8.5"
                                       Foreground="{DynamicResource OrangeBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Margin="0,4,7,0" ToolTip="{Binding OverrideTip}">
                                <TextBlock.Visibility>
                                    <Binding Path="HasOverride" Mode="OneWay">
                                        <Binding.Converter>
                                            <helpers:BoolToCollapsedConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </TextBlock.Visibility>
                            </TextBlock>
                        </Grid>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <DataTemplate.Triggers>
                        <!-- Non-current-month cells are dimmed -->
                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                            <Setter TargetName="Cell" Property="Opacity" Value="0.35"/>
                        </DataTrigger>
                        <!-- Today highlight -->
                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource GreenBrush}"/>
                        </DataTrigger>
                        <!-- Rest days get a light red tint (kept subtle so weekend columns stay quiet) -->
                        <DataTrigger Binding="{Binding Status}" Value="Rest">
                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource TagRestBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="PublicHoliday">
                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource TagHolidayBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="MakeupWork">
                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource TagMakeupBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="PaidTimeOff">
                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource TagPtoBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Leave">
                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource TagLeaveBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Legend -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Calendar.Legend.Work}" Style="{StaticResource LegendItem}"/>
            <Ellipse Width="7" Height="7" Fill="{DynamicResource RedBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Calendar.Legend.Rest}" Style="{StaticResource LegendItem}"/>
            <Ellipse Width="7" Height="7" Fill="{DynamicResource AmberBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Calendar.Legend.Holiday}" Style="{StaticResource LegendItem}"/>
            <Ellipse Width="7" Height="7" Fill="{DynamicResource BlueBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Calendar.Legend.Makeup}" Style="{StaticResource LegendItem}"/>
            <Ellipse Width="7" Height="7" Fill="{DynamicResource OrangeBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Calendar.Legend.Pto}" Style="{StaticResource LegendItem}"/>
            <Ellipse Width="7" Height="7" Fill="{DynamicResource PurpleBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Calendar.Legend.Leave}" Style="{StaticResource LegendItem}"/>
        </StackPanel>
        <TextBlock Text="{DynamicResource Calendar.AutoNote}"
                   Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"
                   TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
